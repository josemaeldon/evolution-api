diff --git a/src/pages/instance/Chat/interactive-message-composer.tsx b/src/pages/instance/Chat/interactive-message-composer.tsx
new file mode 100644
index 0000000..bd9c0ae
--- /dev/null
+++ b/src/pages/instance/Chat/interactive-message-composer.tsx
@@ -0,0 +1,326 @@
+import { useQueryClient } from "@tanstack/react-query";
+import { List, MessageSquareMore, Plus, QrCode, Trash2 } from "lucide-react";
+import { useState } from "react";
+import { toast } from "react-toastify";
+import { v4 as uuid } from "uuid";
+
+import { Button } from "@evoapi/design-system/button";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@evoapi/design-system/dropdown-menu";
+import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { Textarea } from "@/components/ui/textarea";
+
+import { api } from "@/lib/queries/api";
+
+import { Instance } from "@/types/evolution.types";
+
+type MessageKind = "buttons" | "list" | "pix" | null;
+type PixKeyType = "phone" | "email" | "cpf" | "cnpj" | "random";
+type RowDraft = { id: string; title: string; description: string };
+type SectionDraft = { id: string; title: string; rows: RowDraft[] };
+
+const newRow = (): RowDraft => ({ id: uuid(), title: "", description: "" });
+const newSection = (): SectionDraft => ({ id: uuid(), title: "", rows: [newRow()] });
+const MAX_BUTTONS = 3;
+const MAX_LIST_ROWS = 10;
+const PIX_KEY_TYPES: { value: PixKeyType; label: string }[] = [
+  { value: "phone", label: "Telefone" },
+  { value: "email", label: "E-mail" },
+  { value: "cpf", label: "CPF" },
+  { value: "cnpj", label: "CNPJ" },
+  { value: "random", label: "Chave aleatória" },
+];
+
+export function InteractiveMessageComposer({ instance, remoteJid }: { instance: Instance; remoteJid: string }) {
+  const queryClient = useQueryClient();
+  const [kind, setKind] = useState<MessageKind>(null);
+  const [isSending, setIsSending] = useState(false);
+  const [title, setTitle] = useState("");
+  const [description, setDescription] = useState("");
+  const [footer, setFooter] = useState("");
+  const [buttonText, setButtonText] = useState("");
+  const [buttons, setButtons] = useState([""]);
+  const [sections, setSections] = useState<SectionDraft[]>([newSection()]);
+  const [pixName, setPixName] = useState("");
+  const [pixKeyType, setPixKeyType] = useState<PixKeyType>("phone");
+  const [pixKey, setPixKey] = useState("");
+  const [pixAmount, setPixAmount] = useState("");
+
+  const openComposer = (nextKind: Exclude<MessageKind, null>) => {
+    setTitle(nextKind === "pix" ? "Pagamento via Pix" : "");
+    setDescription("");
+    setFooter("");
+    setButtonText("");
+    setButtons([""]);
+    setSections([newSection()]);
+    setPixName("");
+    setPixKeyType("phone");
+    setPixKey("");
+    setPixAmount("");
+    setKind(nextKind);
+  };
+
+  const totalRows = sections.reduce((count, section) => count + section.rows.length, 0);
+  const validButtons = buttons.every((label) => label.trim()) &&
+    new Set(buttons.map((label) => label.trim().toLowerCase())).size === buttons.length;
+  const validSections = sections.every(
+    (section) => section.title.trim() && section.rows.every((row) => row.title.trim()),
+  );
+  const validPixAmount = !pixAmount.trim() || (/^\d+(?:[.,]\d{1,2})?$/.test(pixAmount.trim()) &&
+    Number(pixAmount.replace(",", ".")) > 0);
+  const canSend = !!title.trim() && (kind === "buttons" ? validButtons : kind === "pix"
+    ? !!pixName.trim() && !!pixKey.trim() && validPixAmount
+    : !!buttonText.trim() && validSections);
+
+  const updateSection = (sectionId: string, update: (section: SectionDraft) => SectionDraft) => {
+    setSections((current) => current.map((section) => section.id === sectionId ? update(section) : section));
+  };
+
+  const sendInteractiveMessage = async () => {
+    if (!kind || !canSend || isSending) return;
+
+    const fallbackText = kind === "buttons"
+      ? [
+          `*${title.trim()}*`,
+          description.trim(),
+          `Opções:\n${buttons.map((label, index) => `${index + 1}. ${label.trim()}`).join("\n")}`,
+          "Responda com o número da opção escolhida.",
+          footer.trim(),
+        ].filter(Boolean).join("\n\n")
+      : kind === "pix"
+      ? [
+          `*${title.trim()}*`,
+          description.trim(),
+          `Recebedor: ${pixName.trim()}`,
+          `Chave Pix (${PIX_KEY_TYPES.find((type) => type.value === pixKeyType)?.label}):\n${pixKey.trim()}`,
+          pixAmount.trim() ? `Valor: R$ ${Number(pixAmount.replace(",", ".")).toFixed(2).replace(".", ",")}` : "",
+          footer.trim(),
+        ].filter(Boolean).join("\n\n")
+      : null;
+
+    const data = kind === "buttons"
+      ? {
+          number: remoteJid,
+          title: title.trim(),
+          description: description.trim(),
+          footer: footer.trim(),
+          buttons: buttons.map((label) => ({ type: "reply", displayText: label.trim(), id: uuid() })),
+        }
+      : kind === "pix"
+      ? {
+          number: remoteJid,
+          title: title.trim(),
+          description: description.trim(),
+          footer: footer.trim(),
+          buttons: [{
+            type: "pix",
+            name: pixName.trim(),
+            keyType: pixKeyType,
+            key: pixKey.trim(),
+            currency: "BRL",
+            ...(pixAmount.trim() ? { amount: Number(pixAmount.replace(",", ".")) } : {}),
+          }],
+        }
+      : {
+          number: remoteJid,
+          title: title.trim(),
+          description: description.trim(),
+          footerText: footer.trim(),
+          buttonText: buttonText.trim(),
+          sections: sections.map((section) => ({
+            title: section.title.trim(),
+            rows: section.rows.map((row) => ({
+              title: row.title.trim(),
+              description: row.description.trim(),
+              rowId: row.id,
+            })),
+          })),
+        };
+
+    try {
+      setIsSending(true);
+      const headers = { apikey: instance.token };
+      if (fallbackText) {
+        await api.post(`/message/sendText/${instance.name}`, { number: remoteJid, text: fallbackText }, { headers });
+      }
+
+      let interactiveSent = true;
+      try {
+        await api.post(`/message/${kind === "list" ? "sendList" : "sendButtons"}/${instance.name}`, data, { headers });
+      } catch (error) {
+        if (!fallbackText) throw error;
+        interactiveSent = false;
+        console.error("Error sending native interactive message:", error);
+      }
+      setKind(null);
+      queryClient.invalidateQueries({ queryKey: ["chats", "findMessages"] }).catch(console.error);
+      queryClient.invalidateQueries({ queryKey: ["chats", "findChats"] }).catch(console.error);
+      if (interactiveSent) toast.success(fallbackText ? "Mensagem e cópia em texto enviadas" : "Mensagem enviada");
+      else toast.warn("Texto enviado; o botão interativo não pôde ser enviado");
+    } catch (error) {
+      console.error("Error sending interactive message:", error);
+      toast.error("Não foi possível enviar a mensagem");
+    } finally {
+      setIsSending(false);
+    }
+  };
+
+  return (
+    <>
+      <DropdownMenu>
+        <DropdownMenuTrigger asChild>
+          <Button type="button" variant="ghost" size="icon" aria-label="Enviar mensagem interativa" title="Mensagem interativa">
+            <MessageSquareMore className="h-5 w-5" />
+          </Button>
+        </DropdownMenuTrigger>
+        <DropdownMenuContent align="start">
+          <DropdownMenuItem onClick={() => openComposer("buttons")}>
+            <MessageSquareMore className="mr-2 h-4 w-4" /> Botões de resposta
+          </DropdownMenuItem>
+          <DropdownMenuItem onClick={() => openComposer("list")}>
+            <List className="mr-2 h-4 w-4" /> Lista de opções
+          </DropdownMenuItem>
+          {instance.integration === "WHATSAPP-BAILEYS" && (
+            <DropdownMenuItem onClick={() => openComposer("pix")}>
+              <QrCode className="mr-2 h-4 w-4" /> Chave Pix
+            </DropdownMenuItem>
+          )}
+        </DropdownMenuContent>
+      </DropdownMenu>
+
+      <Dialog open={kind !== null} onOpenChange={(open) => { if (!open && !isSending) setKind(null); }}>
+        <DialogContent className="max-h-[90vh] overflow-y-auto sm:max-w-xl">
+          <DialogTitle>{kind === "buttons" ? "Mensagem com botões" : kind === "pix" ? "Enviar chave Pix" : "Mensagem com lista"}</DialogTitle>
+          <DialogDescription>
+            Envie para {remoteJid.split("@")[0]}.
+            {kind !== "list" && " Uma cópia em texto acompanha a mensagem para garantir a leitura em todos os dispositivos."}
+          </DialogDescription>
+
+          <div className="space-y-4">
+            <div className="space-y-1">
+              <label htmlFor="interactive-title" className="text-sm font-medium">Título</label>
+              <Input id="interactive-title" value={title} onChange={(event) => setTitle(event.target.value)} maxLength={1024} />
+            </div>
+            <div className="space-y-1">
+              <label htmlFor="interactive-description" className="text-sm font-medium">Descrição (opcional)</label>
+              <Textarea id="interactive-description" value={description} onChange={(event) => setDescription(event.target.value)} rows={3} />
+            </div>
+            <div className="space-y-1">
+              <label htmlFor="interactive-footer" className="text-sm font-medium">Rodapé (opcional)</label>
+              <Input id="interactive-footer" value={footer} onChange={(event) => setFooter(event.target.value)} />
+            </div>
+
+            {kind === "buttons" ? (
+              <div className="space-y-2">
+                <p className="text-sm font-medium">Botões de resposta (até 3)</p>
+                {buttons.map((label, index) => (
+                  <div key={index} className="flex gap-2">
+                    <Input aria-label={`Texto do botão ${index + 1}`} placeholder={`Botão ${index + 1}`} value={label}
+                      onChange={(event) => setButtons((current) => current.map((value, i) => i === index ? event.target.value : value))} />
+                    <Button type="button" size="icon" variant="ghost" aria-label={`Remover botão ${index + 1}`}
+                      disabled={buttons.length === 1} onClick={() => setButtons((current) => current.filter((_, i) => i !== index))}>
+                      <Trash2 className="h-4 w-4" />
+                    </Button>
+                  </div>
+                ))}
+                {buttons.length < MAX_BUTTONS && (
+                  <Button type="button" size="sm" variant="outline" onClick={() => setButtons((current) => [...current, ""])}>
+                    <Plus className="mr-1 h-4 w-4" /> Adicionar botão
+                  </Button>
+                )}
+                {!validButtons && buttons.every((label) => label.trim()) && (
+                  <p className="text-xs text-destructive">Os textos dos botões devem ser diferentes.</p>
+                )}
+              </div>
+            ) : kind === "pix" ? (
+              <div className="space-y-3">
+                <div className="space-y-1">
+                  <label htmlFor="pix-name" className="text-sm font-medium">Nome do recebedor</label>
+                  <Input id="pix-name" value={pixName} onChange={(event) => setPixName(event.target.value)} />
+                </div>
+                <div className="space-y-1">
+                  <label htmlFor="pix-key-type" className="text-sm font-medium">Tipo de chave</label>
+                  <select id="pix-key-type" value={pixKeyType} onChange={(event) => setPixKeyType(event.target.value as PixKeyType)}
+                    className="h-9 w-full rounded-md border border-input bg-background px-3 text-sm">
+                    {PIX_KEY_TYPES.map((type) => <option key={type.value} value={type.value}>{type.label}</option>)}
+                  </select>
+                </div>
+                <div className="space-y-1">
+                  <label htmlFor="pix-key" className="text-sm font-medium">Chave Pix</label>
+                  <Input id="pix-key" value={pixKey} onChange={(event) => setPixKey(event.target.value)} />
+                </div>
+                <div className="space-y-1">
+                  <label htmlFor="pix-amount" className="text-sm font-medium">Valor em reais (opcional)</label>
+                  <Input id="pix-amount" inputMode="decimal" placeholder="0,00" value={pixAmount}
+                    onChange={(event) => setPixAmount(event.target.value)} aria-invalid={!validPixAmount} />
+                  {!validPixAmount && <p className="text-xs text-destructive">Informe um valor positivo com até duas casas decimais.</p>}
+                </div>
+              </div>
+            ) : (
+              <div className="space-y-4">
+                <div className="space-y-1">
+                  <label htmlFor="interactive-button-text" className="text-sm font-medium">Texto do botão que abre a lista</label>
+                  <Input id="interactive-button-text" value={buttonText} onChange={(event) => setButtonText(event.target.value)} />
+                </div>
+                {sections.map((section, sectionIndex) => (
+                  <div key={section.id} className="space-y-3 rounded-lg border p-3">
+                    <div className="flex items-center gap-2">
+                      <Input aria-label={`Título da seção ${sectionIndex + 1}`} placeholder={`Seção ${sectionIndex + 1}`}
+                        value={section.title} onChange={(event) => updateSection(section.id, (current) => ({ ...current, title: event.target.value }))} />
+                      <Button type="button" size="icon" variant="ghost" aria-label={`Remover seção ${sectionIndex + 1}`}
+                        disabled={sections.length === 1} onClick={() => setSections((current) => current.filter((item) => item.id !== section.id))}>
+                        <Trash2 className="h-4 w-4" />
+                      </Button>
+                    </div>
+                    {section.rows.map((row, rowIndex) => (
+                      <div key={row.id} className="flex gap-2 pl-2">
+                        <div className="min-w-0 flex-1 space-y-2">
+                          <Input aria-label={`Título da opção ${rowIndex + 1} da seção ${sectionIndex + 1}`}
+                            placeholder={`Opção ${rowIndex + 1}`} value={row.title}
+                            onChange={(event) => updateSection(section.id, (current) => ({ ...current,
+                              rows: current.rows.map((item) => item.id === row.id ? { ...item, title: event.target.value } : item),
+                            }))} />
+                          <Input aria-label={`Descrição da opção ${rowIndex + 1} da seção ${sectionIndex + 1}`}
+                            placeholder="Descrição (opcional)" value={row.description} maxLength={72}
+                            onChange={(event) => updateSection(section.id, (current) => ({ ...current,
+                              rows: current.rows.map((item) => item.id === row.id ? { ...item, description: event.target.value } : item),
+                            }))} />
+                        </div>
+                        <Button type="button" size="icon" variant="ghost" aria-label={`Remover opção ${rowIndex + 1}`}
+                          disabled={section.rows.length === 1} onClick={() => updateSection(section.id, (current) => ({
+                            ...current, rows: current.rows.filter((item) => item.id !== row.id),
+                          }))}>
+                          <Trash2 className="h-4 w-4" />
+                        </Button>
+                      </div>
+                    ))}
+                    {totalRows < MAX_LIST_ROWS && (
+                      <Button type="button" size="sm" variant="outline" onClick={() => updateSection(section.id, (current) => ({
+                        ...current, rows: [...current.rows, newRow()],
+                      }))}>
+                        <Plus className="mr-1 h-4 w-4" /> Adicionar opção
+                      </Button>
+                    )}
+                  </div>
+                ))}
+                {totalRows < MAX_LIST_ROWS && (
+                  <Button type="button" size="sm" variant="outline" onClick={() => setSections((current) => [...current, newSection()])}>
+                    <Plus className="mr-1 h-4 w-4" /> Adicionar seção
+                  </Button>
+                )}
+                <p className="text-xs text-muted-foreground">Até {MAX_LIST_ROWS} opções no total.</p>
+              </div>
+            )}
+
+            <div className="flex justify-end gap-2">
+              <Button type="button" variant="outline" disabled={isSending} onClick={() => setKind(null)}>Cancelar</Button>
+              <Button type="button" disabled={!canSend || isSending} onClick={sendInteractiveMessage}>
+                {isSending ? "Enviando..." : "Enviar mensagem"}
+              </Button>
+            </div>
+          </div>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
